type openvfd, domain;
type openvfd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(openvfd)

# Draw the clock on the front panel display
allow openvfd openvfd_device:chr_file rw_file_perms;

# Set the status icons through /sys/class/leds/openvfd
allow openvfd sysfs_leds:dir search;
allow openvfd sysfs_leds:lnk_file read;
allow openvfd sysfs_leds:file w_file_perms;

# Check the eth and wifi links with getifaddrs(), which needs RTM_GETLINK
# (nlmsg_readpriv) for the flags of the interfaces
allow openvfd self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_read nlmsg_readpriv };

# The named pipe in /tmp, which nothing on Android writes to, cannot be
# created by a vendor domain
dontaudit openvfd shell_data_file:dir search;
