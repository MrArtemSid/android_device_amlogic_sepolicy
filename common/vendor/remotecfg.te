type remotecfg, domain;
type remotecfg_exec, exec_type, vendor_file_type, file_type;

# Domain transition
init_daemon_domain(remotecfg)

# Device node rules
type remotecfg_device, dev_type;
allow remotecfg remotecfg_device:chr_file { read write open ioctl };

# SysFS rules
type remotecfg_sysfs, sysfs_type, fs_type;
allow remotecfg sysfs:dir { search };
allow remotecfg remotecfg_sysfs:file { read write open };

# Init permissions
allow init remotecfg_exec:file { execute open read getattr };
